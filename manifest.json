{
  "name": "Navidrome ListenBrainz Sync",
  "author": "egecelikci",
  "version": "0.2.0",
  "description": "Two-way loved-track sync with ListenBrainz and rating sync from CritiqueBrainz",
  "website": "https://github.com/egecelikci/navidrome-listenbrainz-plugin",
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "user_links": {
          "type": "array",
          "title": "Linked users",
          "description": "One entry per Navidrome user. Each links a Navidrome user to their own ListenBrainz account by token.",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "navidrome_username": {
                "type": "string",
                "title": "Navidrome username",
                "minLength": 1
              },
              "listenbrainz_token": {
                "type": "string",
                "title": "ListenBrainz token",
                "description": "The user's ListenBrainz user token (kept secret). The ListenBrainz username is derived from it.",
                "minLength": 1
              },
              "critiquebrainz_username": {
                "type": "string",
                "title": "CritiqueBrainz username",
                "description": "Optional. Defaults to the ListenBrainz username, which is the same MusicBrainz account name for most users. Set this only when the two differ."
              }
            },
            "required": ["navidrome_username", "listenbrainz_token"]
          }
        },
        "cb_sync_artists": {
          "type": "object",
          "title": "CritiqueBrainz artists",
          "description": "Applies CritiqueBrainz artist ratings to Navidrome artists. Leave both options off to ignore artist ratings.",
          "default": { "sync_rating": false, "favorite_at": 0 },
          "properties": {
            "sync_rating": {
              "type": "boolean",
              "title": "Copy the rating",
              "description": "Set the Navidrome rating to the CritiqueBrainz rating.",
              "default": false
            },
            "favorite_at": {
              "type": "integer",
              "title": "Favorite at or above",
              "description": "0 disables favoriting. At 1-5, an artist rated at least this high on CritiqueBrainz is also marked as a Favorite in Navidrome.",
              "default": 0,
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "cb_sync_albums": {
          "type": "object",
          "title": "CritiqueBrainz albums (release groups)",
          "description": "Applies CritiqueBrainz release group ratings to Navidrome albums. Leave both options off to ignore album ratings.",
          "default": { "sync_rating": false, "favorite_at": 0 },
          "properties": {
            "sync_rating": {
              "type": "boolean",
              "title": "Copy the rating",
              "description": "Set the Navidrome rating to the CritiqueBrainz rating.",
              "default": false
            },
            "favorite_at": {
              "type": "integer",
              "title": "Favorite at or above",
              "description": "0 disables favoriting. At 1-5, an album rated at least this high on CritiqueBrainz is also marked as a Favorite in Navidrome.",
              "default": 0,
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "cb_sync_recordings": {
          "type": "object",
          "title": "CritiqueBrainz tracks (recordings)",
          "description": "Applies CritiqueBrainz recording ratings to the matching Navidrome songs. Leave both options off to ignore track ratings.",
          "default": { "sync_rating": false, "favorite_at": 0 },
          "properties": {
            "sync_rating": {
              "type": "boolean",
              "title": "Copy the rating",
              "description": "Set the Navidrome rating to the CritiqueBrainz rating.",
              "default": false
            },
            "favorite_at": {
              "type": "integer",
              "title": "Favorite at or above",
              "description": "0 disables favoriting. At 1-5, a track rated at least this high on CritiqueBrainz is also marked as a Favorite in Navidrome.",
              "default": 0,
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "sync_inbound": {
          "type": "boolean",
          "title": "Favorite tracks loved on ListenBrainz",
          "default": true
        },
        "sync_outbound": {
          "type": "boolean",
          "title": "Love tracks favorited in Navidrome",
          "default": true
        },
        "sync_schedule": {
          "type": "string",
          "title": "Sync cron expression",
          "default": "*/30 * * * *"
        },
        "dry_run": {
          "type": "boolean",
          "title": "Dry run (report only, write nothing)",
          "default": true
        },
        "batch_size": {
          "type": "integer",
          "title": "Items per matcher batch",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        },
        "request_delay_ms": {
          "type": "integer",
          "title": "Delay between ListenBrainz API calls (ms, min 1000)",
          "default": 1000,
          "minimum": 1000
        },
        "max_per_run": {
          "type": "integer",
          "title": "Max changes per user per pass",
          "default": 500,
          "minimum": 1
        }
      },
      "required": ["user_links"]
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/user_links",
          "options": {
            "elementLabelProp": "navidrome_username",
            "detail": {
              "type": "VerticalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/navidrome_username"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/listenbrainz_token",
                  "options": {
                    "format": "password"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/critiquebrainz_username"
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/sync_inbound"
        },
        {
          "type": "Control",
          "scope": "#/properties/sync_outbound"
        },
        {
          "type": "Control",
          "scope": "#/properties/sync_schedule"
        },
        {
          "type": "Control",
          "scope": "#/properties/dry_run"
        },
        {
          "type": "Control",
          "scope": "#/properties/batch_size"
        },
        {
          "type": "Control",
          "scope": "#/properties/request_delay_ms"
        },
        {
          "type": "Control",
          "scope": "#/properties/max_per_run"
        },
        {
          "type": "Group",
          "label": "CritiqueBrainz artists → Navidrome artists",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/cb_sync_artists/properties/sync_rating"
            },
            {
              "type": "Control",
              "scope": "#/properties/cb_sync_artists/properties/favorite_at"
            }
          ]
        },
        {
          "type": "Group",
          "label": "CritiqueBrainz albums (release groups) → Navidrome albums",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/cb_sync_albums/properties/sync_rating"
            },
            {
              "type": "Control",
              "scope": "#/properties/cb_sync_albums/properties/favorite_at"
            }
          ]
        },
        {
          "type": "Group",
          "label": "CritiqueBrainz tracks (recordings) → Navidrome songs",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/cb_sync_recordings/properties/sync_rating"
            },
            {
              "type": "Control",
              "scope": "#/properties/cb_sync_recordings/properties/favorite_at"
            }
          ]
        }
      ]
    }
  },
  "permissions": {
    "http": {
      "reason": "Read ListenBrainz feedback and tokens, and CritiqueBrainz ratings",
      "requiredHosts": ["api.listenbrainz.org", "critiquebrainz.org"]
    },
    "users": {
      "reason": "Act only for the Navidrome users assigned to this plugin"
    },
    "subsonicapi": {
      "reason": "Read favorited tracks, search for MBID matches, and favorite or rate matched items"
    },
    "matcher": {
      "reason": "Resolve ListenBrainz recording MBIDs to local tracks"
    },
    "library": {
      "reason": "Required by the matcher permission"
    },
    "kvstore": {
      "reason": "Store the already-reconciled recordings and CritiqueBrainz states per user",
      "maxSize": "32MB"
    },
    "scheduler": {
      "reason": "Run the periodic sync pass"
    }
  }
}
